<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🧠 노브레인 서바이벌 - 30인 서바이벌 상식 퀴즈</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Do+Hyeon&family=Gamja+Flower&family=Pretendard:wght@400;600;800;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        dohyeon: ['Do Hyeon', 'sans-serif'],
                        gamja: ['Gamja Flower', 'cursive'],
                        sans: ['Pretendard', 'sans-serif'],
                    },
                    colors: {
                        retro: {
                            yellow: '#FFE600',
                            pink: '#FF007A',
                            cyan: '#00F0FF',
                            purple: '#7000FF',
                            dark: '#0D0914',
                            card: '#1A1528',
                            green: '#00FF66',
                            red: '#FF2A55'
                        }
                    },
                    boxShadow: {
                        'neon-pink': '0 0 15px rgba(255, 0, 122, 0.6), 4px 4px 0px #000',
                        'neon-cyan': '0 0 15px rgba(0, 240, 255, 0.6), 4px 4px 0px #000',
                        'neon-yellow': '0 0 15px rgba(255, 230, 0, 0.6), 4px 4px 0px #000',
                        'retro-black': '5px 5px 0px #000000',
                        'retro-sm': '3px 3px 0px #000000'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0D0914;
            color: #FFFFFF;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(112, 0, 255, 0.15) 0%, transparent 60%),
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 100% 100%, 30px 30px, 30px 30px;
        }

        .retro-border {
            border: 3px solid #000000;
        }

        @keyframes pulse-fast {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
        .animate-pulse-fast {
            animation: pulse-fast 0.8s infinite;
        }

        /* LED Indicator lights */
        .led-indicator {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            display: inline-block;
            border: 2px solid #000;
        }
        .led-white { background-color: #FFFFFF; box-shadow: 0 0 8px #FFFFFF; }
        .led-green { background-color: #00FF66; box-shadow: 0 0 12px #00FF66; }
        .led-red { background-color: #FF2A55; box-shadow: 0 0 12px #FF2A55; }
    </style>
</head>
<body class="min-h-screen font-sans flex flex-col justify-between selection:bg-retro-pink selection:text-white">

    <!-- TOP HEADER -->
    <header class="w-full bg-retro-card/90 border-b-4 border-black p-3 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchRole('lobby')">
                <img src="loca_avatar.png" alt="이로카 Loca" class="w-11 h-11 rounded-xl border-2 border-retro-yellow shadow-retro-sm object-cover bg-black">
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-dohyeon text-xl sm:text-2xl text-retro-yellow tracking-wider drop-shadow-[2px_2px_0px_#000]">
                            노브레인 서바이벌
                        </h1>
                        <span class="bg-retro-purple text-retro-yellow font-dohyeon text-xs px-2.5 py-0.5 rounded-full border border-black shadow-retro-sm flex items-center gap-1">
                            <span>🐸</span> 주최: 이로카 Loca
                        </span>
                    </div>
                    <p class="text-xs text-retro-cyan font-bold tracking-widest uppercase">실시간 30초 시한폭탄 상식퀴즈</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2" id="header-status">
                <span id="role-badge" class="px-3 py-1 rounded-full text-xs font-black uppercase border-2 border-black bg-gray-700 text-white shadow-retro-sm">
                    로비
                </span>
                <button onclick="switchRole('lobby')" class="bg-retro-pink hover:bg-pink-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg border-2 border-black shadow-retro-sm transition active:translate-y-0.5">
                    <i class="fa-solid fa-right-from-bracket mr-1"></i> 역할 변경
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl w-full mx-auto p-4 sm:p-6 flex-1 flex flex-col justify-center">

        <!-- 1. LOBBY SCREEN -->
        <section id="view-lobby" class="flex flex-col items-center justify-center py-8 text-center space-y-8">
            <div class="space-y-3 max-w-2xl">
                <div class="flex items-center justify-center gap-3 mb-2">
                    <img src="loca_avatar.png" alt="이로카 Loca" class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl border-3 border-black shadow-neon-yellow bg-black object-cover animate-pulse-fast">
                    <div class="inline-block bg-retro-yellow text-black font-dohyeon text-base sm:text-lg px-4 py-1 rounded-full border-2 border-black shadow-retro-sm transform -rotate-1">
                        🐸 이로카 Loca 주최 &bull; 30인 최강 상식 최약체 가리기 서바이벌 ⚡
                    </div>
                </div>
                <h2 class="font-dohyeon text-4xl sm:text-6xl text-white tracking-wide leading-tight drop-shadow-[4px_4px_0px_#FF007A]">
                    문제당 <span class="text-retro-yellow">30초</span> 제한시간!<br>
                    정답은 <span class="text-retro-green">초록불</span>, 오답은 <span class="text-retro-red">붉은불</span>
                </h2>
                <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
                    개최자는 30초 타이머와 출제를 컨트롤하며 최대 30명의 정답을 실시간으로 채점합니다.<br>
                    다음 문제로 이동 시 모든 참가자의 표시등이 <strong class="text-white">하얀색</strong>으로 자동 초기화됩니다!
                </p>
            </div>

            <!-- Role Selector Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full max-w-2xl">
                <!-- Host Option -->
                <div onclick="switchRole('host')" class="group cursor-pointer bg-retro-card hover:bg-purple-900/40 p-6 rounded-2xl border-4 border-black shadow-neon-pink transition-all transform hover:-translate-y-1 text-left relative overflow-hidden">
                    <div class="absolute -right-4 -bottom-4 text-8xl opacity-10 group-hover:opacity-20 transition">👑</div>
                    <span class="bg-retro-pink text-white text-xs font-bold px-2.5 py-1 rounded border border-black uppercase shadow-retro-sm">Host Dashboard</span>
                    <h3 class="font-dohyeon text-2xl text-retro-yellow mt-3 mb-1">👑 개최자 (진행자)</h3>
                    <p class="text-xs text-gray-300 leading-normal">
                        30명 참가자 실시간 정답 채점, 30초 타이머 제어, O/X 상태 및 색상 현황을 총괄합니다.
                    </p>
                    <div class="mt-4 flex items-center text-retro-pink font-bold text-sm group-hover:translate-x-1 transition">
                        개최자 대시보드 입장 <i class="fa-solid fa-arrow-right ml-2"></i>
                    </div>
                </div>

                <!-- Participant Option -->
                <div onclick="switchRole('participant')" class="group cursor-pointer bg-retro-card hover:bg-cyan-900/40 p-6 rounded-2xl border-4 border-black shadow-neon-cyan transition-all transform hover:-translate-y-1 text-left relative overflow-hidden">
                    <div class="absolute -right-4 -bottom-4 text-8xl opacity-10 group-hover:opacity-20 transition">🕹️</div>
                    <span class="bg-retro-cyan text-black text-xs font-bold px-2.5 py-1 rounded border border-black uppercase shadow-retro-sm">Player Screen</span>
                    <h3 class="font-dohyeon text-2xl text-retro-cyan mt-3 mb-1">🎮 참가자 (최대 30명)</h3>
                    <p class="text-xs text-gray-300 leading-normal">
                        닉네임 등록 후 30초 카운트다운 내 정답을 입력합니다. (타인의 정답은 보이지 않음)
                    </p>
                    <div class="mt-4 flex items-center text-retro-cyan font-bold text-sm group-hover:translate-x-1 transition">
                        참가자 모드 접속하기 <i class="fa-solid fa-arrow-right ml-2"></i>
                    </div>
                </div>
            </div>

            <!-- Demo Quick Simulator -->
            <div class="bg-black/40 border border-gray-800 rounded-xl p-4 max-w-xl text-xs text-gray-400 text-left flex gap-3 items-center">
                <i class="fa-solid fa-circle-info text-retro-cyan text-2xl flex-shrink-0"></i>
                <p><strong>30인 테스트 안내:</strong> 개최자 화면에서 <span class="text-retro-yellow font-bold">[🤖 가상 참가자 30명 채우기]</span> 버튼을 누르면 30명 풀방 테스트를 즉시 체험할 수 있습니다.</p>
            </div>
        </section>

        <!-- 2. PARTICIPANT VIEW -->
        <section id="view-participant" class="hidden space-y-6">
            <!-- Join Section -->
            <div id="part-login-card" class="max-w-md mx-auto bg-retro-card p-6 rounded-2xl border-4 border-black shadow-neon-cyan text-center space-y-4">
                <div class="text-4xl">🚀</div>
                <h3 class="font-dohyeon text-2xl text-retro-cyan">참가자 프로필 등록</h3>
                <p class="text-xs text-gray-300">대회에서 사용할 닉네임을 입력하세요 (최대 30명 접속 가능)</p>
                <div>
                    <input type="text" id="part-name-input" maxlength="10" placeholder="닉네임 (예: 천재지변, 뇌순남)" 
                           class="w-full bg-black/60 border-2 border-retro-cyan text-white p-3 rounded-xl text-center text-lg font-bold focus:outline-none focus:ring-2 focus:ring-retro-cyan">
                </div>
                <button onclick="registerParticipant()" class="w-full bg-retro-cyan hover:bg-cyan-400 text-black font-dohyeon text-xl py-3 rounded-xl border-2 border-black shadow-retro-black transition active:translate-y-1">
                    대회 참가 신청
                </button>
            </div>

            <!-- Participant Main Game Board -->
            <div id="part-game-card" class="hidden space-y-6 max-w-2xl mx-auto">
                <!-- Status Bar with Color LED -->
                <div id="part-status-bar" class="bg-retro-card p-4 rounded-xl border-4 border-black shadow-retro-black flex justify-between items-center transition-all duration-500">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-retro-purple border-2 border-black flex items-center justify-center font-bold text-lg text-retro-yellow" id="part-avatar">
                            ?
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span id="part-display-name" class="font-bold text-lg text-white">참가자</span>
                                <span id="part-led-indicator" class="led-indicator led-white"></span>
                            </div>
                            <span id="part-status-tag" class="px-2 py-0.5 rounded text-[11px] font-black bg-white text-black border border-black">
                                대기중 (하얀색)
                            </span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-gray-400 block">현재 라운드</span>
                        <span id="part-round-num" class="font-dohyeon text-retro-yellow text-xl">ROUND 1</span>
                    </div>
                </div>

                <!-- Current Question & 30s Countdown Card -->
                <div class="bg-retro-card p-6 sm:p-8 rounded-2xl border-4 border-black shadow-neon-yellow relative overflow-hidden">
                    <div class="flex justify-between items-center mb-4">
                        <span class="bg-retro-purple text-retro-yellow text-xs font-bold px-3 py-1 rounded-full border border-black">
                            <i class="fa-solid fa-bullhorn mr-1"></i> 문제 출제
                        </span>
                        
                        <!-- 30-Second Timer Display -->
                        <div id="part-timer-container" class="flex items-center gap-2 bg-black/80 px-4 py-1.5 rounded-full border-2 border-retro-yellow">
                            <span class="text-xs font-bold text-gray-400">제한시간:</span>
                            <span id="part-timer-text" class="font-dohyeon text-2xl text-retro-yellow min-w-[36px] text-center">30</span>
                            <span class="text-xs font-bold text-retro-yellow">초</span>
                        </div>
                    </div>

                    <h2 id="part-question-text" class="font-dohyeon text-2xl sm:text-3xl text-white min-h-[90px] flex items-center justify-center text-center leading-snug">
                        개최자가 30초 퀴즈를 출제할 때까지 기다려주세요...
                    </h2>
                </div>

                <!-- Answer Input Area -->
                <div class="bg-retro-card p-6 rounded-2xl border-4 border-black shadow-retro-black space-y-4">
                    <label class="block font-dohyeon text-retro-cyan text-lg">
                        <i class="fa-solid fa-pen-to-square mr-1"></i> 정답 입력란 (30초 제한)
                    </label>
                    <div class="space-y-3">
                        <input type="text" id="part-answer-input" placeholder="정답을 입력하세요 (제출 전까지 수정 가능)" 
                               class="w-full bg-black/70 border-2 border-gray-700 text-white p-4 rounded-xl font-bold text-lg focus:outline-none focus:border-retro-cyan transition">
                        
                        <button id="part-submit-btn" onclick="submitAnswer()" class="w-full bg-retro-yellow hover:bg-yellow-400 text-black font-dohyeon text-2xl py-4 rounded-xl border-3 border-black shadow-retro-black transition active:translate-y-1 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fa-solid fa-paper-plane mr-2"></i> 정답 제출하기
                        </button>
                    </div>

                    <!-- Submission Feedback -->
                    <div id="part-feedback" class="hidden p-3 rounded-xl border-2 border-black text-center font-bold text-sm"></div>
                </div>
            </div>
        </section>

        <!-- 3. HOST VIEW (개최자 / 진행자) -->
        <section id="view-host" class="hidden space-y-6">
            <!-- Host Top Control Desk -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Question Control Panel -->
                <div class="lg:col-span-2 bg-retro-card p-6 rounded-2xl border-4 border-black shadow-neon-pink space-y-4">
                    <div class="flex justify-between items-center border-b-2 border-gray-800 pb-3">
                        <h2 class="font-dohyeon text-2xl text-retro-yellow flex items-center gap-2">
                            <img src="loca_avatar.png" alt="이로카 Loca" class="w-8 h-8 rounded-lg border border-black object-cover">
                            <span>👑</span> 이로카 Loca 진행 데스크
                        </h2>
                        <div class="flex items-center gap-2">
                            <label class="text-xs text-gray-400 font-bold">라운드:</label>
                            <input type="number" id="host-round-input" value="1" min="1" class="w-16 bg-black border border-gray-700 text-retro-yellow text-center font-dohyeon py-1 rounded">
                        </div>
                    </div>

                    <!-- Question Sample Picker -->
                    <div class="flex gap-2">
                        <select id="host-sample-questions" onchange="loadSampleQuestion()" class="flex-1 bg-black border-2 border-gray-700 text-xs text-gray-300 p-2.5 rounded-lg focus:outline-none focus:border-retro-pink">
                            <option value="">💡 추천 상식 퀴즈 (30초 전용)</option>
                            <option value="1">Q. 세종대왕이 만든 한글의 원래 이름은?</option>
                            <option value="2">Q. '사흘'은 며칠을 의미할까요?</option>
                            <option value="3">Q. 신사임당의 아들로 10만양병설을 주장한 학자는?</option>
                            <option value="4">Q. 세계에서 가장 넓은 바다는 어디일까요?</option>
                            <option value="5">Q. 독도는 어느 행정구역(도)에 속해 있을까요?</option>
                            <option value="6">Q. '바나나'는 나무에서 열리는 열매이다? (O/X)</option>
                        </select>
                    </div>

                    <!-- Question & Answer Inputs -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold text-gray-400 mb-1">문제 내용</label>
                            <input type="text" id="host-question-input" placeholder="참가자 30명에게 출제할 문제 입력" 
                                   class="w-full bg-black/80 border-2 border-retro-pink text-white p-2.5 rounded-xl font-bold focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-400 mb-1">정답 (자동 채점 키워드)</label>
                            <input type="text" id="host-answer-input" placeholder="정답 키워드 (예: 훈민정음)" 
                                   class="w-full bg-black/80 border-2 border-retro-green text-retro-green p-2.5 rounded-xl font-bold focus:outline-none">
                        </div>
                    </div>

                    <!-- Action Controls -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2">
                        <button onclick="start30sQuiz()" class="bg-retro-pink hover:bg-pink-600 text-white font-dohyeon py-3 rounded-xl border-2 border-black shadow-retro-sm transition active:translate-y-0.5 text-sm flex items-center justify-center gap-1">
                            <i class="fa-solid fa-play"></i> 30초 퀴즈 출제 & 시작
                        </button>
                        <button onclick="nextQuestionReset()" class="bg-retro-yellow hover:bg-yellow-400 text-black font-dohyeon py-3 rounded-xl border-2 border-black shadow-retro-sm transition active:translate-y-0.5 text-sm flex items-center justify-center gap-1">
                            <i class="fa-solid fa-forward"></i> 다음 문제로 (하얀색 초기화)
                        </button>
                        <button onclick="autoGradeAll()" class="bg-retro-cyan hover:bg-cyan-400 text-black font-dohyeon py-3 rounded-xl border-2 border-black shadow-retro-sm transition active:translate-y-0.5 text-sm flex items-center justify-center gap-1">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> 일괄 자동 채점
                        </button>
                        <button onclick="stopTimer()" class="bg-gray-800 hover:bg-gray-700 text-white font-dohyeon py-3 rounded-xl border-2 border-black shadow-retro-sm transition active:translate-y-0.5 text-sm flex items-center justify-center gap-1">
                            <i class="fa-solid fa-hand"></i> 타이머 수동 마감
                        </button>
                    </div>
                </div>

                <!-- Session Stats & Test Tools -->
                <div class="bg-retro-card p-6 rounded-2xl border-4 border-black shadow-retro-black flex flex-col justify-between space-y-4">
                    <div>
                        <div class="flex justify-between items-center border-b border-gray-800 pb-2">
                            <h3 class="font-dohyeon text-xl text-retro-cyan">
                                📊 30인 현황 요약
                            </h3>
                            <span id="host-timer-display" class="font-dohyeon text-xl text-retro-yellow">⏱️ 30s</span>
                        </div>

                        <!-- Status Cards -->
                        <div class="grid grid-cols-3 gap-2 text-center my-4">
                            <div class="bg-black/50 p-2.5 rounded-xl border border-gray-800">
                                <span class="text-[11px] text-gray-400 block">참가자 수</span>
                                <span id="host-stat-total" class="font-dohyeon text-xl text-white">0 / 30명</span>
                            </div>
                            <div class="bg-black/50 p-2.5 rounded-xl border border-gray-800">
                                <span class="text-[11px] text-retro-green block">정답자 (초록)</span>
                                <span id="host-stat-green" class="font-dohyeon text-xl text-retro-green">0명</span>
                            </div>
                            <div class="bg-black/50 p-2.5 rounded-xl border border-gray-800">
                                <span class="text-[11px] text-retro-red block">오답자 (붉은)</span>
                                <span id="host-stat-red" class="font-dohyeon text-xl text-retro-red">0명</span>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Tools & FX -->
                    <div class="space-y-2">
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="populateDummyParticipants(30)" class="bg-purple-900/40 hover:bg-purple-900/70 text-retro-yellow border border-purple-500 text-xs font-bold py-2 rounded-lg">
                                🤖 30명 봇 채우기
                            </button>
                            <button onclick="simulateDummyAnswers()" class="bg-cyan-900/40 hover:bg-cyan-900/70 text-retro-cyan border border-cyan-500 text-xs font-bold py-2 rounded-lg">
                                📝 30명 임의답안 제출
                            </button>
                        </div>
                        <div class="grid grid-cols-2 gap-2 pt-1">
                            <button onclick="playSound('correct')" class="bg-retro-green/20 text-retro-green border border-retro-green text-xs font-bold py-1.5 rounded-lg">
                                ⭕ 정답 sound
                            </button>
                            <button onclick="playSound('wrong')" class="bg-retro-red/20 text-retro-red border border-retro-red text-xs font-bold py-1.5 rounded-lg">
                                ❌ 오답 sound
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 30-Participant Matrix Board -->
            <div class="bg-retro-card p-6 rounded-2xl border-4 border-black shadow-retro-black space-y-4">
                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3 border-b-2 border-gray-800 pb-4">
                    <div>
                        <h3 class="font-dohyeon text-2xl text-white flex items-center gap-2">
                            <span>🎮</span> 참가자 30인 정답 & 채점 현황판
                        </h3>
                        <p class="text-xs text-gray-400">참가자의 입력 정답과 초록불(정답)/붉은불(오답) 상태가 개최자에게만 실시간 표시됩니다.</p>
                    </div>

                    <div class="flex gap-2">
                        <button onclick="clearAllParticipants()" class="bg-red-900/40 hover:bg-red-900/60 text-xs text-red-300 font-bold px-3 py-1.5 rounded-lg border border-red-700">전체 참가자 초기화</button>
                    </div>
                </div>

                <!-- Grid of up to 30 Participant Cards -->
                <div id="host-participants-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-3">
                    <!-- Empty State -->
                    <div class="col-span-full py-12 text-center text-gray-500 space-y-2">
                        <i class="fa-solid fa-users-slash text-4xl"></i>
                        <p class="font-bold">접속한 참가자가 없습니다 (최대 30명 접속 가능)</p>
                        <p class="text-xs">참가자 화면 탭을 열거나 '30명 봇 채우기' 버튼으로 테스트해보세요.</p>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="w-full bg-black/60 border-t border-gray-800 p-4 text-center text-xs text-gray-400 flex flex-col sm:flex-row items-center justify-center gap-2">
        <div class="flex items-center gap-1.5">
            <img src="loca_avatar.png" alt="이로카 Loca" class="w-5 h-5 rounded border border-gray-700 object-cover">
            <span>주최: <strong class="text-retro-yellow font-bold">이로카 Loca</strong></span>
        </div>
        <span class="hidden sm:inline">&bull;</span>
        <span>🧠 노브레인 서바이벌 대회 (최대 30인) &bull; 30초 제한시간 / 초록불(정답) & 붉은불(오답) 동기화</span>
    </footer>

    <!-- JAVASCRIPT APPLICATION LOGIC -->
    <script>
        // --- 1. GLOBAL STATE & REAL-TIME BROADCAST CHANNEL ---
        const CHANNEL_NAME = 'nobrain_survival_30p_channel';
        const channel = new BroadcastChannel(CHANNEL_NAME);

        // Application State
        let state = {
            currentRound: 1,
            question: '',
            referenceAnswer: '',
            timer: 30,
            isTimerActive: false,
            participants: {} 
            /*
              participants[id] = {
                  name: '닉네임',
                  answer: '제출한 정답',
                  submitted: false,
                  statusColor: 'white' // 'white' (대기), 'green' (정답), 'red' (오답)
              }
            */
        };

        let currentRole = 'lobby';
        let myParticipantId = localStorage.getItem('no_brain_my_id') || 'p_' + Math.random().toString(36).substr(2, 9);
        localStorage.setItem('no_brain_my_id', myParticipantId);

        let myName = localStorage.getItem('no_brain_my_name') || '';
        let timerInterval = null;

        function saveState() {
            localStorage.setItem('nobrain_30p_state', JSON.stringify(state));
        }

        function loadSavedState() {
            const saved = localStorage.getItem('nobrain_30p_state');
            if (saved) {
                try {
                    state = JSON.parse(saved);
                } catch(e) {}
            }
        }

        // --- 2. AUDIO SYNTHESIZER ---
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            try {
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                const now = audioCtx.currentTime;

                if (type === 'correct') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.1);
                    osc.frequency.setValueAtTime(783.99, now + 0.2);
                    osc.frequency.setValueAtTime(1046.50, now + 0.3);
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                    osc.start(now);
                    osc.stop(now + 0.5);
                } else if (type === 'wrong') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(180, now);
                    osc.frequency.linearRampToValueAtTime(100, now + 0.4);
                    gain.gain.setValueAtTime(0.4, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);
                    osc.start(now);
                    osc.stop(now + 0.45);
                } else if (type === 'tick') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(800, now);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.04);
                    osc.start(now);
                    osc.stop(now + 0.04);
                } else if (type === 'start') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, now);
                    osc.frequency.setValueAtTime(880, now + 0.15);
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                }
            } catch(e) {}
        }

        // --- 3. BROADCAST MESSAGING ---
        function broadcastStateChange(actionType, extra = {}) {
            saveState();
            channel.postMessage({
                type: actionType,
                state: state,
                sender: myParticipantId,
                extra: extra
            });
            render();
        }

        channel.onmessage = (event) => {
            const data = event.data;
            if (data && data.state) {
                state = data.state;
                saveState();
                render();

                if (data.type === 'SOUND_EVENT' && currentRole === 'participant') {
                    playSound(data.extra.sound);
                }
            }
        };

        // --- 4. NAVIGATION & ROLE MANAGEMENT ---
        function switchRole(role) {
            currentRole = role;
            document.getElementById('view-lobby').classList.add('hidden');
            document.getElementById('view-participant').classList.add('hidden');
            document.getElementById('view-host').classList.add('hidden');

            const badge = document.getElementById('role-badge');

            if (role === 'lobby') {
                document.getElementById('view-lobby').classList.remove('hidden');
                badge.className = 'px-3 py-1 rounded-full text-xs font-black uppercase border-2 border-black bg-gray-700 text-white shadow-retro-sm';
                badge.innerText = '로비';
            } else if (role === 'participant') {
                document.getElementById('view-participant').classList.remove('hidden');
                badge.className = 'px-3 py-1 rounded-full text-xs font-black uppercase border-2 border-black bg-retro-cyan text-black shadow-retro-sm';
                badge.innerText = '참가자 모드';
                checkParticipantLogin();
            } else if (role === 'host') {
                document.getElementById('view-host').classList.remove('hidden');
                badge.className = 'px-3 py-1 rounded-full text-xs font-black uppercase border-2 border-black bg-retro-pink text-white shadow-retro-sm';
                badge.innerText = '개최자 모드';
            }
            render();
        }

        // --- 5. PARTICIPANT LOGIC ---
        function checkParticipantLogin() {
            const loginCard = document.getElementById('part-login-card');
            const gameCard = document.getElementById('part-game-card');

            if (myName) {
                loginCard.classList.add('hidden');
                gameCard.classList.remove('hidden');
                
                if (!state.participants[myParticipantId]) {
                    state.participants[myParticipantId] = {
                        name: myName,
                        answer: '',
                        submitted: false,
                        statusColor: 'white'
                    };
                    broadcastStateChange('PARTICIPANT_JOINED');
                }
            } else {
                loginCard.classList.remove('hidden');
                gameCard.classList.add('hidden');
            }
        }

        function registerParticipant() {
            const input = document.getElementById('part-name-input');
            const val = input.value.trim();
            if (!val) {
                alert('닉네임을 입력해주세요!');
                return;
            }
            myName = val;
            localStorage.setItem('no_brain_my_name', myName);
            checkParticipantLogin();
        }

        function submitAnswer() {
            const answerInput = document.getElementById('part-answer-input');
            const ans = answerInput.value.trim();

            if (!ans) {
                alert('정답을 입력하신 후 제출해주세요!');
                return;
            }

            if (!state.participants[myParticipantId]) return;

            state.participants[myParticipantId].answer = ans;
            state.participants[myParticipantId].submitted = true;

            broadcastStateChange('SUBMIT_ANSWER');
        }

        // --- 6. HOST CONTROL LOGIC ---
        function loadSampleQuestion() {
            const select = document.getElementById('host-sample-questions');
            const val = select.value;
            const qInput = document.getElementById('host-question-input');
            const aInput = document.getElementById('host-answer-input');

            const samples = {
                '1': { q: '세종대왕이 만든 한글의 원래 이름은 무엇일까요?', a: '훈민정음' },
                '2': { q: "'사흘'은 며칠을 의미할까요?", a: '3일' },
                '3': { q: '신사임당의 아들로 10만양병설을 주장한 학자는?', a: '율곡 이이' },
                '4': { q: '세계에서 가장 넓은 면적의 바다는 어디일까요?', a: '태평양' },
                '5': { q: '독도는 어느 행정구역(도)에 속해 있을까요?', a: '경상북도' },
                '6': { q: '바나나는 나무에서 열린다? (O / X)', a: 'X' }
            };

            if (samples[val]) {
                qInput.value = samples[val].q;
                aInput.value = samples[val].a;
            }
        }

        // Start 30-second Quiz
        function start30sQuiz() {
            const round = parseInt(document.getElementById('host-round-input').value) || 1;
            const qText = document.getElementById('host-question-input').value.trim();
            const aText = document.getElementById('host-answer-input').value.trim();

            if (!qText) {
                alert('출제할 문제 내용을 입력해주세요!');
                return;
            }

            state.currentRound = round;
            state.question = qText;
            state.referenceAnswer = aText;
            state.timer = 30;
            state.isTimerActive = true;

            playSound('start');

            // Start global countdown
            if (timerInterval) clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                if (state.timer > 0) {
                    state.timer--;
                    if (state.timer <= 5 && state.timer > 0) {
                        playSound('tick');
                    }
                    if (state.timer === 0) {
                        state.isTimerActive = false;
                        clearInterval(timerInterval);
                        playSound('wrong');
                        // Time's up: Auto grade remaining un-graded
                        autoGradeAll();
                    }
                    broadcastStateChange('TIMER_TICK');
                }
            }, 1000);

            broadcastStateChange('START_30S_QUIZ');
        }

        function stopTimer() {
            if (timerInterval) clearInterval(timerInterval);
            state.isTimerActive = false;
            broadcastStateChange('STOP_TIMER');
        }

        // NEXT QUESTION: Reset color indicators for ALL participants to WHITE
        function nextQuestionReset() {
            if (timerInterval) clearInterval(timerInterval);

            state.currentRound = (state.currentRound || 1) + 1;
            state.question = '';
            state.referenceAnswer = '';
            state.timer = 30;
            state.isTimerActive = false;

            // Reset all participants' answers and set status back to WHITE
            Object.keys(state.participants).forEach(id => {
                state.participants[id].answer = '';
                state.participants[id].submitted = false;
                state.participants[id].statusColor = 'white';
            });

            document.getElementById('host-question-input').value = '';
            document.getElementById('host-answer-input').value = '';

            broadcastStateChange('NEXT_QUESTION_RESET');
        }

        // Set Pass/Fail color manually for an individual participant
        function setParticipantColor(id, color) {
            if (state.participants[id]) {
                state.participants[id].statusColor = color;
                if (color === 'green') playSound('correct');
                if (color === 'red') playSound('wrong');
                broadcastStateChange('COLOR_CHANGE', { participantId: id, color });
            }
        }

        // Auto Grade All based on keyword match
        function autoGradeAll() {
            const refAns = (state.referenceAnswer || '').trim().toLowerCase();
            if (!refAns) {
                alert('모범 정답 키워드를 입력하면 자동 채점이 가능합니다.');
                return;
            }

            Object.keys(state.participants).forEach(id => {
                const p = state.participants[id];
                const userAns = (p.answer || '').trim().toLowerCase();

                if (userAns && (userAns === refAns || userAns.includes(refAns) || refAns.includes(userAns))) {
                    p.statusColor = 'green';
                } else {
                    p.statusColor = 'red';
                }
            });

            playSound('correct');
            broadcastStateChange('AUTO_GRADE_COMPLETE');
        }

        // Populate 30 dummy participants for testing
        function populateDummyParticipants(count = 30) {
            const sampleNames = [
                "김상식", "이뇌순", "박퀴즈", "최정답", "정오답",
                "강서바이벌", "조노브레인", "윤천재", "장명수", "임백호",
                "한바다", "오하늘", "서산호", "신태양", "권은하",
                "황지구", "송우주", "류혜성", "전가람", "홍나래",
                "고아라", "문은별", "양솔잎", "손버들", "배단풍",
                "백노을", "허이슬", "남바람", "심구름", "노태풍"
            ];

            for (let i = 0; i < count; i++) {
                const dummyId = 'dummy_' + (i + 1);
                state.participants[dummyId] = {
                    name: sampleNames[i] || `참가자${i+1}`,
                    answer: '',
                    submitted: false,
                    statusColor: 'white'
                };
            }
            broadcastStateChange('POPULATE_DUMMIES');
        }

        // Simulate random dummy answers for testing
        function simulateDummyAnswers() {
            const mockAnswers = ["훈민정음", "3일", "율곡 이이", "태평양", "경상북도", "모름", "2일", "세종대왕", "X", "O"];
            Object.keys(state.participants).forEach(id => {
                if (id.startsWith('dummy_')) {
                    state.participants[id].answer = mockAnswers[Math.floor(Math.random() * mockAnswers.length)];
                    state.participants[id].submitted = true;
                }
            });
            broadcastStateChange('SIMULATE_ANSWERS');
        }

        function clearAllParticipants() {
            if (confirm('참가자 목록을 전부 초기화하시겠습니까?')) {
                state.participants = {};
                broadcastStateChange('CLEAR_PARTICIPANTS');
            }
        }

        // --- 7. MAIN RENDER FUNCTION ---
        function render() {
            // Update Host inputs
            document.getElementById('host-round-input').value = state.currentRound || 1;
            document.getElementById('host-timer-display').innerText = `⏱️ ${state.timer}s`;

            // Calculate Counts
            const pList = Object.values(state.participants);
            const totalCount = pList.length;
            const greenCount = pList.filter(p => p.statusColor === 'green').length;
            const redCount = pList.filter(p => p.statusColor === 'red').length;

            document.getElementById('host-stat-total').innerText = `${totalCount} / 30명`;
            document.getElementById('host-stat-green').innerText = `${greenCount}명`;
            document.getElementById('host-stat-red').innerText = `${redCount}명`;

            // --- PARTICIPANT SCREEN RENDER ---
            if (currentRole === 'participant' && myName) {
                const myInfo = state.participants[myParticipantId] || { answer: '', submitted: false, statusColor: 'white' };

                document.getElementById('part-avatar').innerText = myName.charAt(0);
                document.getElementById('part-display-name').innerText = myName;
                document.getElementById('part-round-num').innerText = 'ROUND ' + state.currentRound;

                // Color Status LED & Bar update
                const statusBar = document.getElementById('part-status-bar');
                const statusTag = document.getElementById('part-status-tag');
                const led = document.getElementById('part-led-indicator');

                if (myInfo.statusColor === 'green') {
                    // Correct - GREEN
                    statusBar.className = 'bg-retro-green/20 border-4 border-retro-green p-4 rounded-xl shadow-neon-green transition-all duration-500';
                    statusTag.className = 'px-2 py-0.5 rounded text-[11px] font-black bg-retro-green text-black border border-black';
                    statusTag.innerText = '⭕ 정답! (초록불)';
                    led.className = 'led-indicator led-green';
                } else if (myInfo.statusColor === 'red') {
                    // Incorrect - RED
                    statusBar.className = 'bg-retro-red/20 border-4 border-retro-red p-4 rounded-xl shadow-neon-pink transition-all duration-500';
                    statusTag.className = 'px-2 py-0.5 rounded text-[11px] font-black bg-retro-red text-white border border-black';
                    statusTag.innerText = '❌ 오답! (붉은불)';
                    led.className = 'led-indicator led-red';
                } else {
                    // Default - WHITE (Clean Reset for next question)
                    statusBar.className = 'bg-retro-card border-4 border-black p-4 rounded-xl shadow-retro-black transition-all duration-500';
                    statusTag.className = 'px-2 py-0.5 rounded text-[11px] font-black bg-white text-black border border-black';
                    statusTag.innerText = '⚪ 대기중 (하얀색)';
                    led.className = 'led-indicator led-white';
                }

                // Question Text & Timer
                document.getElementById('part-question-text').innerText = state.question || '개최자가 30초 퀴즈를 출제할 때까지 기다려주세요...';
                document.getElementById('part-timer-text').innerText = state.timer;

                const timerContainer = document.getElementById('part-timer-container');
                if (state.timer <= 5 && state.isTimerActive) {
                    timerContainer.className = 'flex items-center gap-2 bg-retro-red/80 px-4 py-1.5 rounded-full border-2 border-white animate-pulse-fast';
                } else {
                    timerContainer.className = 'flex items-center gap-2 bg-black/80 px-4 py-1.5 rounded-full border-2 border-retro-yellow';
                }

                // Input Controls
                const inputArea = document.getElementById('part-answer-input');
                const submitBtn = document.getElementById('part-submit-btn');
                const feedback = document.getElementById('part-feedback');

                if (!state.isTimerActive && state.timer === 0) {
                    inputArea.disabled = true;
                    submitBtn.disabled = true;
                    feedback.classList.remove('hidden');
                    feedback.className = 'p-3 rounded-xl border-2 border-black bg-gray-800 text-gray-300 text-center font-bold text-sm';
                    feedback.innerHTML = '⏱️ <strong class="text-retro-yellow">30초 제한시간 마감!</strong> 채점 결과를 기다리세요.';
                } else if (!state.isTimerActive && !state.question) {
                    inputArea.disabled = true;
                    submitBtn.disabled = true;
                    feedback.classList.remove('hidden');
                    feedback.className = 'p-3 rounded-xl border-2 border-black bg-gray-800 text-gray-400 text-center font-bold text-sm';
                    feedback.innerHTML = '⏳ 다음 문제를 기다리는 중입니다... (상태 초기화 완료)';
                } else if (myInfo.submitted) {
                    inputArea.disabled = false;
                    submitBtn.disabled = false;
                    feedback.classList.remove('hidden');
                    feedback.className = 'p-3 rounded-xl border-2 border-black bg-retro-cyan/20 text-retro-cyan text-center font-bold text-sm border-retro-cyan';
                    feedback.innerHTML = `✅ <strong class="text-white">제출된 답안: "${escapeHtml(myInfo.answer)}"</strong> (30초 전까지 수정 가능)`;
                } else {
                    inputArea.disabled = false;
                    submitBtn.disabled = false;
                    feedback.classList.add('hidden');
                }
            }

            // --- HOST DASHBOARD RENDER (30 Participants Grid) ---
            if (currentRole === 'host') {
                const container = document.getElementById('host-participants-container');
                const entries = Object.entries(state.participants);

                if (entries.length === 0) {
                    container.innerHTML = `
                        <div class="col-span-full py-12 text-center text-gray-500 space-y-2">
                            <i class="fa-solid fa-users-slash text-4xl"></i>
                            <p class="font-bold">접속한 참가자가 없습니다 (최대 30명 접속 가능)</p>
                            <p class="text-xs">참가자 화면 탭을 열거나 '30명 봇 채우기' 버튼으로 테스트해보세요.</p>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = entries.map(([id, p]) => {
                    const color = p.statusColor || 'white';
                    
                    let bgCardClass = 'bg-black/80 border-gray-700';
                    let ledClass = 'led-white';
                    let statusLabel = '대기중';

                    if (color === 'green') {
                        bgCardClass = 'bg-green-950/40 border-retro-green shadow-[0_0_10px_rgba(0,255,102,0.3)]';
                        ledClass = 'led-green';
                        statusLabel = '정답 (초록)';
                    } else if (color === 'red') {
                        bgCardClass = 'bg-red-950/40 border-retro-red shadow-[0_0_10px_rgba(255,42,85,0.3)]';
                        ledClass = 'led-red';
                        statusLabel = '오답 (붉은)';
                    }

                    return `
                        <div class="p-3 rounded-xl border-2 ${bgCardClass} relative flex flex-col justify-between space-y-2 shadow-retro-sm transition-all duration-300">
                            <!-- Card Header -->
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-1.5 truncate">
                                    <span class="${ledClass}"></span>
                                    <span class="font-dohyeon text-sm text-white truncate max-w-[80px]" title="${escapeHtml(p.name)}">${escapeHtml(p.name)}</span>
                                </div>
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${p.submitted ? 'bg-retro-cyan text-black' : 'bg-gray-800 text-gray-400'}">
                                    ${p.submitted ? '제출' : '미제출'}
                                </span>
                            </div>

                            <!-- Submitted Answer Box -->
                            <div class="bg-black/60 p-2 rounded-lg border border-gray-800 min-h-[44px] flex items-center justify-center text-center">
                                ${p.submitted 
                                    ? `<p class="font-bold text-retro-yellow text-xs break-all">${escapeHtml(p.answer)}</p>` 
                                    : `<p class="text-[10px] text-gray-600 italic">작성 중...</p>`
                                }
                            </div>

                            <!-- Quick O/X Buttons -->
                            <div class="grid grid-cols-2 gap-1 pt-1">
                                <button onclick="setParticipantColor('${id}', 'green')" class="bg-retro-green/20 hover:bg-retro-green text-retro-green hover:text-black font-dohyeon py-1 rounded text-xs border border-retro-green transition">
                                    ⭕ 초록
                                </button>
                                <button onclick="setParticipantColor('${id}', 'red')" class="bg-retro-red/20 hover:bg-retro-red text-retro-red hover:text-white font-dohyeon py-1 rounded text-xs border border-retro-red transition">
                                    ❌ 붉은
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        function escapeHtml(str) {
            return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        window.onload = function() {
            loadSavedState();
            render();
        };
    </script>
</body>
</html>
